{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "cotego",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "./src/worker.mjs",
  "secrets": {
    "required": [
      "FOOTBALL_DATA_API_KEY"
    ]
  },
  "previews": {
    "version_metadata": {
      "binding": "CF_VERSION_METADATA"
    },
    "d1_databases": [
      {
        "binding": "COTEGO_AUDIT_DB",
        "database_name": "cotego-preview-audit",
        "database_id": "842ecb55-38b6-4fbc-8be5-830c51fc4104"
      }
    ],
    "vars": {
      "COTEGO_JOURNAL_SETUP": "ready"
    }
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "build": {
    "command": "node src/build-preview.mjs"
  }
}
