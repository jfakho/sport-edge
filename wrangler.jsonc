{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "cotego",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "./src/worker.mjs",
  "secrets": {
    "required": [
      "FOOTBALL_DATA_API_KEY"
    ]
  },
  "previews": {}
}
